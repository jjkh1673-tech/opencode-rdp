{
    "name": "Elite Autonomous Workspace",
    "build": {
        "dockerfile": "../docker/Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/sshd:1": {
            "version": "latest"
        }
    },
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb"
    },
    "forwardPorts": [6080, 7860],
    "portsAttributes": {
        "6080": {
            "label": "Browser Desktop",
            "onAutoForward": "openBrowser",
            "requireLocalPort": true,
            "protocol": "http"
        },
        "7860": {
            "label": "Hermes API",
            "onAutoForward": "silent"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "security.workspace.trust.enabled": false,
                "security.workspace.trust.startupPrompt": "never"
            }
        }
    },
    "overrideCommand": false,
    "postCreateCommand": "bash /usr/local/bin/scripts/verify.sh",
    "remoteUser": "root"
}
