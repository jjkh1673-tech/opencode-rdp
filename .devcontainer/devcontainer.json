{
    "name": "Elite Autonomous Workspace",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb"
    },
    "forwardPorts": [6080, 7860],
    "portsAttributes": {
        "6080": {
            "label": "Browser Desktop",
            "onAutoForward": "openBrowser",
            "requireLocalPort": true,
            "protocol": "http"
        },
        "7860": {
            "label": "Hermes API",
            "onAutoForward": "silent"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "security.workspace.trust.enabled": false,
                "security.workspace.trust.startupPrompt": "never"
            }
        }
    },
    "postCreateCommand": "bash .devcontainer/install-user.sh",
    "postStartCommand": "bash .devcontainer/startup.sh",
    "remoteUser": "root"
}
