{
    "name": "Web GUI Codespace (Root & Hermes)",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb"
    },
    "forwardPorts": [6080],
    "portsAttributes": {
        "6080": {
            "label": "Web Desktop",
            "onAutoForward": "notify"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "security.workspace.trust.enabled": false,
                "security.workspace.trust.startupPrompt": "never"
            }
        }
    },
    "postCreateCommand": "bash /usr/local/bin/setup-hermes.sh",
    "postStartCommand": "bash /usr/local/bin/start-kiosk.sh",
    "remoteUser": "root"
}
